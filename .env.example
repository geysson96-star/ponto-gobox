# Copie este arquivo para .env NO SERVIDOR e preencha. Nunca versione o .env.
# Nenhum destes valores é enviado ao navegador.

# Ambiente: production liga cookie seguro (HTTPS) automaticamente.
NODE_ENV=production
PORT=3000

# Acesso ao painel /admin
ADMIN_USER=
# Gere com: npm run senha   (cole a linha completa que o comando mostrar)
ADMIN_PASSWORD_HASH=

# Duração da sessão do administrador (horas)
SESSION_HOURS=12

# Cookie só por HTTPS. Deixe em true em produção.
COOKIE_SECURE=true
# true se o site ficar atrás de proxy/HTTPS (Nginx, Render, Railway, Cloudflare)
TRUST_PROXY=true

# Onde ficam o banco de dados e a pasta de entrada
DATA_DIR=data
# INBOX_DIR=data/entrada

# Verificação automática da pasta de entrada (minutos). 0 desliga.
INBOX_INTERVAL_MINUTES=5

# Consultas públicas permitidas por IP, por minuto
PUBLIC_RATE_PER_MINUTE=20

# Tamanho máximo do relatório enviado pelo painel (MB)
MAX_UPLOAD_MB=20

# ---- Robô de sincronização com os portais ----
# Liga o robô que lê Shopee SPX e Mercado Livre Places usando a sessão
# salva no navegador do robô (faça login com: npm run robo:login).
ROBO_ATIVO=false
ROBO_INTERVALO_MINUTOS=10
ROBO_FONTES=shopee,ml
# msedge (padrão no Windows) ou chrome
ROBO_NAVEGADOR=msedge
# true para ver a janela do robô trabalhando (diagnóstico)
ROBO_VISIVEL=false
# Ponto da agência na Shopee (vazio = detecta o único ponto que não é "Admin")
SHOPEE_PONTO_ID=

# Aba Ponto do painel: acesso de administrador do Ponto GoBox (Firebase), para entrar sem pedir login.
PONTO_EMAIL=
PONTO_SENHA=
