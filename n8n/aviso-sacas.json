{
  "name": "GoBox - Aviso de sacas no grupo",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "a1c0f6f0-0001-4c00-9000-000000000001",
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "site",
              "value": "https://gobox-consulta.onrender.com",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "chave",
              "value": "COLE_AQUI_A_CHAVE_DA_EXTENSAO",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "whatsappUrl",
              "value": "http://gobox_evolution:8080",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "instancia",
              "value": "Gobox",
              "type": "string"
            },
            {
              "id": "c5",
              "name": "whatsappApiKey",
              "value": "COLE_AQUI_A_APIKEY",
              "type": "string"
            },
            {
              "id": "c6",
              "name": "grupoDelivery",
              "value": "120363429605511103@g.us",
              "type": "string"
            },
            {
              "id": "c7",
              "name": "grupoNex",
              "value": "120363428476324315@g.us",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1c0f6f0-0002-4c00-9000-000000000002",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.site }}/api/sacas/proximo",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.chave }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "id": "a1c0f6f0-0003-4c00-9000-000000000003",
      "name": "Buscar próximo aviso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1c0f6f0-0004-4c00-9000-000000000004",
      "name": "Tem aviso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').item.json.whatsappUrl }}/message/sendText/{{ $('Configuração').item.json.instancia }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Configuração').item.json.whatsappApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.text }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1c0f6f0-0005-4c00-9000-000000000005",
      "name": "Mandar no grupo (WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').item.json.site }}/api/sacas/avisos/{{ $('Buscar próximo aviso').item.json.body.id }}/resultado",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuração').item.json.chave }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"ok\": true }",
        "options": {}
      },
      "id": "a1c0f6f0-0006-4c00-9000-000000000006",
      "name": "Confirmar: enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').item.json.site }}/api/sacas/avisos/{{ $('Buscar próximo aviso').item.json.body.id }}/resultado",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Configuração').item.json.chave }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ok: false, erro: String(($json.error && ($json.error.message || $json.error)) || 'Falha ao mandar no WhatsApp').slice(0, 200) }) }}",
        "options": {}
      },
      "id": "a1c0f6f0-0007-4c00-9000-000000000007",
      "name": "Confirmar: falhou",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').item.json.whatsappUrl }}/chat/findChats/{{ $('Configuração').item.json.instancia }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Configuração').item.json.whatsappApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"where\": {} }",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1c0f6f0-0008-4c00-9000-000000000008",
      "name": "Listar grupos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Delivery (sacas para entregar) -> grupo Delivery; Next (Mercado Envios Extra) -> grupo dos entregadores.\n// Usa o ID do grupo (terminado em @g.us) ou procura pelo nome nas conversas do WhatsApp.\nconst cfg = $('Configuração').first().json;\nconst aviso = $('Buscar próximo aviso').first().json.body;\nconst alvo = String((aviso.grupo === 'nex' ? cfg.grupoNex : cfg.grupoDelivery) || '').trim();\nlet id = alvo.endsWith('@g.us') ? alvo : null;\nif (!id) {\n  const normal = (s) => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().trim();\n  const grupos = $input.all().map((i) => i.json).flat()\n    .map((c) => ({ id: c.remoteJid || c.id, nome: c.name || c.subject || c.pushName }))\n    .filter((c) => String(c.id || '').endsWith('@g.us'));\n  const achado = grupos.find((g) => normal(g.nome) === normal(alvo)) || grupos.find((g) => normal(g.nome).includes(normal(alvo)));\n  if (!achado) throw new Error(`Grupo \"${alvo}\" não encontrado no WhatsApp conectado.`);\n  id = achado.id;\n}\nreturn [{ json: { number: id, text: aviso.texto } }];"
      },
      "id": "a1c0f6f0-0009-4c00-9000-000000000009",
      "name": "Escolher grupo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "onError": "continueErrorOutput"
    }
  ],
  "connections": {
    "A cada minuto": {
      "main": [
        [
          {
            "node": "Configuração",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuração": {
      "main": [
        [
          {
            "node": "Buscar próximo aviso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar próximo aviso": {
      "main": [
        [
          {
            "node": "Tem aviso?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tem aviso?": {
      "main": [
        [
          {
            "node": "Listar grupos",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Mandar no grupo (WhatsApp)": {
      "main": [
        [
          {
            "node": "Confirmar: enviado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Confirmar: falhou",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Listar grupos": {
      "main": [
        [
          {
            "node": "Escolher grupo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Confirmar: falhou",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Escolher grupo": {
      "main": [
        [
          {
            "node": "Mandar no grupo (WhatsApp)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Confirmar: falhou",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}